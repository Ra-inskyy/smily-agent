[Unit]
Description=smily agent endpoint (Agent Games)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hatch/workspace/goals/agent-games-creator-track/wildcard/smily-agent
Environment=PORT=8787
Environment=HTTP_PROXY=http://hatch-egress-proxy:3128
Environment=HTTPS_PROXY=http://hatch-egress-proxy:3128
Environment=http_proxy=http://hatch-egress-proxy:3128
Environment=https_proxy=http://hatch-egress-proxy:3128
Environment=NO_PROXY=localhost,127.0.0.1
Environment=NODE_USE_ENV_PROXY=1
Environment=SSL_CERT_FILE=/run/hatch/egress-tls/ca-bundle.pem
Environment=NODE_EXTRA_CA_CERTS=/run/hatch/egress-tls/ca-bundle.pem
# Platform HMAC secret for Agent Games (0600 file, never committed).
EnvironmentFile=/home/hatch/workspace/goals/agent-games-creator-track/wildcard/smily-agent/run/agent.env
ExecStart=/usr/bin/node src/server.mjs
Restart=always
RestartSec=5
StandardOutput=append:/tmp/smily-server.log
StandardError=append:/tmp/smily-server.log

[Install]
WantedBy=multi-user.target
